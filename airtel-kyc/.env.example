# staging | production
AIRTEL_ENV=staging

# Optional overrides. Defaults follow the Zambia OpenAPI hosts.
# AIRTEL_BASE_URL=https://openapiuat.airtel.co.zm
# AIRTEL_TOKEN_PATH=/auth/oauth2/token
# AIRTEL_USER_PATH=/standard/v1/users

# Consumer key and secret from the Airtel Money developer portal (Zambia).
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_GRANT_TYPE=client_credentials

# Required enquiry headers.
AIRTEL_COUNTRY=ZM
AIRTEL_CURRENCY=ZMW
AIRTEL_ACCEPT=*/*

# How the MSISDN is sent to Airtel: national (971234567), local (0971234567), or international (260971234567).
AIRTEL_MSISDN_FORMAT=national

# Set to true to simulate lookups without calling Airtel.
AIRTEL_MOCK=false

AIRTEL_TIMEOUT_MS=15000

# Leave empty for open local use. Set this before exposing the app on a network.
ACCESS_KEY=

PORT=8787
HOST=0.0.0.0
# Set to true when the app is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# Set to true only when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY=false
